  "scripts": {
    "test": "mocha test/**/*.test.js --reporter mochawesome --reporter-options reportDir=reports,reportFilename=test-report",
    "coverage": "c8 --reporter=html --reporter=text npm test",
    "eslint": "eslint utils/**/*.js test/**/*.js",
