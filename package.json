  "license": "ISC",
  "bugs": {
    "url": "https://github.com/PinkPeonyD/practice_unit/issues"
  },
  "homepage": "https://github.com/PinkPeonyD/practice_unit#readme",
  "devDependencies": {
    "@babel/core": "^7.28.4",
    "@babel/preset-env": "^7.28.3",
    "babel-loader": "^10.0.0",
    "c8": "^10.1.3",
    "chai": "^6.2.0",
    "eslint": "^9.37.0",
    "husky": "^9.1.7",
    "lint-staged": "^13.0.0",
    "mocha": "^11.7.4",
    "mochawesome": "^7.1.4"
  },
  "lint-staged": {
    "*.js": [
